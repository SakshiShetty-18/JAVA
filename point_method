class MyPoint {
private int x;
private int y;
public MyPoint() {
this.x = 0;
this.y = 0;
}
public MyPoint(int x, int y) {
this.x = x;
this.y = y;
}
public void setXY(int x, int y) {
this.x = x;
this.y = y;
}
public int[] getXY() {
int[] coordinates = {x, y};
return coordinates;
}
public double distance(int x, int y) {
int xDiff = this.x - x;
int yDiff = this.y - y;
return Math.sqrt(xDiff * xDiff + yDiff * yDiff);

}
public double distance(MyPoint another) {
int xDiff = this.x - another.x;
int yDiff = this.y - another.y;
return Math.sqrt(xDiff * xDiff + yDiff * yDiff);
}
public double distance() {
return Math.sqrt(x * x + y * y);
}
@Override
public String toString() {
return "(" + x + ", " + y + ")";
}
}

public class TestMyPoint {
public static void main(String[] args) {
MyPoint point1 = new MyPoint(); // Using default constructor
MyPoint point2 = new MyPoint(3, 4); // Using overloaded constructor
point1.setXY(1, 2);
int[] coordinates = point1.getXY();
System.out.println("Point 1 coordinates: (" + coordinates[0] + ", " + coordinates[1] +
")");
System.out.println("Distance from Point 1 to (5, 6): " + point1.distance(5, 6));
System.out.println("Distance from Point 1 to Point 2: " + point1.distance(point2));
System.out.println("Distance from Point 1 to the origin: " + point1.distance());
System.out.println("Point 1: " + point1);
System.out.println("Point 2: " + point2);
}
}
