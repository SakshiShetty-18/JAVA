import java.util.Scanner;
class Stack{
int top;
int s[]=new int[10];

Stack(){

top=-1;
}
void push(int item){
if(s.length-1==top){

System.out.println("Stack over folw");

return;
}
else{

top+=1;
s[top]=item;
}
}
void pop(){
if(top== -1){

System.out.println("Stack underflow");

return;
}
else{

int item=s[top];

System.out.println("item deleted popped :"+item);

top-=1;
}
}
void display(){
if(top== -1){

System.out.println("Stack is empty, no item to display");

}
else{
System.out.println("Item in stack are:");
for(int i=top;i>=0;i--){
System.out.println(s[i]);

}
}
}

}
